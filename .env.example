# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MONGODB_URI: Required for MERN stack persistent storage
# Provide your MongoDB connection string here. If missing, app will fallback to in-memory.
MONGODB_URI="mongodb+srv://<user>:<password>@cluster.mongodb.net/acropulse?retryWrites=true&w=majority"

