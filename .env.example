# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MONGODB_URI: Required for MERN stack persistent storage
# Provide your MongoDB connection string here. Defaults to local MongoDB if not set.
MONGODB_URI="mongodb://localhost:27017/wkly"

# JWT_SECRET: Secret key used to sign and verify HS256 JWT tokens.
JWT_SECRET="REPLACE_WITH_256_BIT_RANDOM_SECRET_IN_PRODUCTION"

# USER TOKEN LIMITS & AI QUOTA CONFIGURATION
DAILY_TOKEN_LIMIT="15000"
MAX_TOKENS_PER_REQUEST="1500"
DAILY_AI_REQUEST_LIMIT="30"
